# Secrets — never commit
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Dependencies
node_modules/

# NOT ignored, deliberately: dist/ and vendor/ are build output that MUST be
# committed. GitHub Pages serves this repo exactly as checked in — there is no
# deploy step to build in — so an ignored dist/ means index.html 404s on its
# own scripts. `npm run verify:build` (CI) fails if either drifts.

# Playwright E2E artifacts
playwright-report/
test-results/

# Local tooling & design scratch (not part of the published Pages site)
.claude/
.design-canvas.state.json
uploads/
screenshots/
review/
heroreview/
assetcap/
cardpng/
# Scratch audit doc — a point-in-time design review, not maintained docs;
# content goes stale quickly (e.g. references to already-fixed findings), so
# it stays local instead of being tracked.
DESIGN-SYSTEM-AUDIT.md

# Design-tool outputs & local dev artifacts
GitHub ID Images.html
